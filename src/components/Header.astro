---
import { SITE_NAME, SITE_URL, SUPPORTED_LANGS } from '@/consts';

interface Props {
  lang?: string;
  currentPath?: string;
}

const { lang = 'en', currentPath = '' } = Astro.props;

function localePath(path: string, l: string) {
  if (l === 'en') return path;
  const slug = path.replace(/^\//, '');
  return `/${l}${slug ? `/${slug}` : ''}`;
}

const navLinks = [
  { key: 'home', href: lang === 'en' ? '/' : `/${lang}` },
  { key: 'bmi', href: localePath('/bmi-calculator', lang) },
  { key: 'bmr', href: localePath('/bmr-calculator', lang) },
  { key: 'tdee', href: localePath('/tdee-calculator', lang) },
];

const langNames: Record<string, string> = {
  en: 'EN', zh: '中文', es: 'ES', fr: 'FR',
  de: 'DE', ja: '日本語', ko: '한국어', pt: 'PT',
  ru: 'RU', ar: 'AR',
};

// Nav labels by lang (subset for header; full i18n via JSON in pages)
const navLabels: Record<string, string[]> = {
  en: ['Home', 'BMI', 'BMR', 'TDEE'],
  zh: ['首页', 'BMI', 'BMR', 'TDEE'],
  es: ['Inicio', 'IMC', 'TMB', 'TDEE'],
  fr: ['Accueil', 'IMC', 'MB', 'TDEE'],
  de: ['Home', 'BMI', 'BMR', 'TDEE'],
  ja: ['ホーム', 'BMI', 'BMR', 'TDEE'],
  ko: ['홈', 'BMI', 'BMR', 'TDEE'],
  pt: ['Início', 'IMC', 'TMB', 'TDEE'],
  ru: ['Главная', 'ИМТ', 'ОО', 'TDEE'],
  ar: ['الرئيسية', 'BMI', 'BMR', 'TDEE'],
};

const labels = navLabels[lang] ?? navLabels.en;
const currentLangSlug = currentPath.split('/').filter(Boolean)[0] ?? '';
---
<header class="bg-white border-b border-gray-200 sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href={lang === 'en' ? '/' : `/${lang}`} class="flex items-center gap-2 font-bold text-xl text-green-600">
        <svg width="28" height="28" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
          <circle cx="32" cy="32" r="32" fill="#16a34a"/>
          <text x="32" y="42" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="white" text-anchor="middle">H</text>
        </svg>
        {SITE_NAME}
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-6" aria-label="Main navigation">
        {navLinks.map((link, i) => (
          <a
            href={link.href}
            class="text-sm font-medium text-gray-600 hover:text-green-600 transition-colors"
          >
            {labels[i]}
          </a>
        ))}
      </nav>

      <!-- Lang switcher -->
      <div class="relative group">
        <button
          class="flex items-center gap-1 text-sm font-medium text-gray-600 hover:text-green-600 border border-gray-200 rounded-lg px-3 py-1.5 transition-colors"
          aria-label="Select language"
          aria-haspopup="true"
        >
          {langNames[lang] ?? 'EN'}
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <ul class="absolute right-0 mt-1 w-36 bg-white border border-gray-200 rounded-xl shadow-lg py-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
          {SUPPORTED_LANGS.map((l) => {
            const slug = currentPath.replace(`/${lang}`, '').replace(/^\/+/, '') || '';
            const href = l === 'en' ? `/${slug}` : `/${l}${slug ? `/${slug}` : ''}`;
            return (
              <li>
                <a
                  href={href}
                  class={`block px-4 py-2 text-sm hover:bg-green-50 hover:text-green-600 ${l === lang ? 'font-semibold text-green-600' : 'text-gray-700'}`}
                >
                  {langNames[l]}
                </a>
              </li>
            );
          })}
        </ul>
      </div>

      <!-- Mobile menu button -->
      <button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg text-gray-600 hover:bg-gray-100" aria-label="Open menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>

    <!-- Mobile nav -->
    <nav id="mobile-menu" class="hidden md:hidden pb-4 border-t border-gray-100 mt-2 pt-3" aria-label="Mobile navigation">
      {navLinks.map((link, i) => (
        <a
          href={link.href}
          class="block py-2 text-sm font-medium text-gray-700 hover:text-green-600"
        >
          {labels[i]}
        </a>
      ))}
    </nav>
  </div>

</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
