---
interface Props {
  title: string;
  description: string;
  href: string;
  icon?: string;
}
const { title, description, href, icon = '📊' } = Astro.props;
---
<a
  href={href}
  class="block rounded-2xl shadow-md bg-white p-6 hover:shadow-lg hover:-translate-y-1 transition-all duration-200 border border-gray-100 group"
>
  <div class="text-4xl mb-4">{icon}</div>
  <h2 class="text-xl font-bold text-gray-800 group-hover:text-green-600 mb-2 transition-colors">{title}</h2>
  <p class="text-gray-500 text-sm leading-relaxed">{description}</p>
  <div class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-green-600">
    Open Calculator
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
  </div>
</a>
