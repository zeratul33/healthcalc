---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AdSlot from '@/components/AdSlot.astro';
import TDEECalculator from '@/components/calculators/TDEECalculator';
import { SITE_URL, SUPPORTED_LANGS } from '@/consts';
import { makeTranslator } from '@/i18n/utils';

export async function getStaticPaths() {
  const nonEnglish = SUPPORTED_LANGS.filter((l) => l !== 'en');
  return nonEnglish.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;

const allTranslations: Record<string, Record<string, unknown>> = {
  zh: (await import('@/i18n/zh.json')).default,
  es: (await import('@/i18n/es.json')).default,
  fr: (await import('@/i18n/fr.json')).default,
  de: (await import('@/i18n/de.json')).default,
  ja: (await import('@/i18n/ja.json')).default,
  ko: (await import('@/i18n/ko.json')).default,
  pt: (await import('@/i18n/pt.json')).default,
  ru: (await import('@/i18n/ru.json')).default,
  ar: (await import('@/i18n/ar.json')).default,
};

const dict = allTranslations[lang] ?? allTranslations.zh;
const t = makeTranslator(dict);
const canonical = `${SITE_URL}/${lang}/tdee-calculator`;

const alternates = SUPPORTED_LANGS.map((l) => ({
  lang: l,
  href: l === 'en' ? `${SITE_URL}/tdee-calculator` : `${SITE_URL}/${l}/tdee-calculator`,
}));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: t('tdee.title'),
    applicationCategory: 'HealthApplication',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    url: canonical,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'What is TDEE?', acceptedAnswer: { '@type': 'Answer', text: 'TDEE (Total Daily Energy Expenditure) is the total calories your body burns per day including all physical activity.' } },
      { '@type': 'Question', name: 'How much below TDEE to lose weight?', acceptedAnswer: { '@type': 'Answer', text: 'A deficit of 300–500 calories below TDEE per day leads to gradual, sustainable weight loss.' } },
    ],
  },
];
---
<BaseLayout
  title={t('meta.tdee_title')}
  description={t('meta.tdee_desc')}
  canonical={canonical}
  lang={lang}
  alternates={alternates}
  schema={schema}
  currentPath={`/${lang}/tdee-calculator`}
>
  <div class="max-w-3xl mx-auto">
    <header class="mb-8 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3">{t('tdee.title')}</h1>
      <p class="text-lg text-gray-600">{t('tdee.desc')}</p>
    </header>

    <TDEECalculator client:load dict={dict} />
    <AdSlot />

    <section class="mt-12 bg-white rounded-2xl shadow-sm p-8 border border-gray-100">
      <p class="text-gray-600 leading-relaxed">{t('meta.tdee_desc')}</p>
      <p class="mt-4 text-sm text-gray-400">
        For the full guide in English, visit the <a href="/tdee-calculator" class="text-green-600 underline">English TDEE Calculator page</a>.
      </p>
    </section>

    <section class="mt-8" aria-label="FAQ">
      <h2 class="text-2xl font-bold text-gray-800 mb-4">FAQ</h2>
      <div class="space-y-3">
        <details class="border border-gray-200 rounded-xl p-4 bg-white">
          <summary class="font-semibold text-gray-800 cursor-pointer">What is TDEE?</summary>
          <p class="mt-3 text-gray-600">TDEE is the total number of calories your body burns each day including all physical activity. It is calculated by multiplying your BMR by an activity factor.</p>
        </details>
        <details class="border border-gray-200 rounded-xl p-4 bg-white">
          <summary class="font-semibold text-gray-800 cursor-pointer">How do I use TDEE to lose weight?</summary>
          <p class="mt-3 text-gray-600">Eat 300–500 calories below your TDEE daily for steady, sustainable weight loss of approximately 0.3–0.5 kg per week.</p>
        </details>
        <details class="border border-gray-200 rounded-xl p-4 bg-white">
          <summary class="font-semibold text-gray-800 cursor-pointer">Does TDEE change over time?</summary>
          <p class="mt-3 text-gray-600">Yes. As your weight or activity level changes, recalculate your TDEE every 4–6 weeks to keep your calorie targets accurate.</p>
        </details>
      </div>
    </section>
  </div>
</BaseLayout>
